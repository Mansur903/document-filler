{
  "name": "document-filler",
  "version": "0.1.0",
  "description": "Minimal Electron shell for Document Filler.",
  "main": "dist-electron/main.js",
  "scripts": {
    "ng": "ng",
    "start": "set \"ELECTRON_RUN_AS_NODE=\" && electron .",
    "dev": "concurrently --kill-others --success first \"npm:dev:angular\" \"npm:dev:electron\"",
    "dev:angular": "ng serve --host 127.0.0.1 --port 4200",
    "dev:electron": "wait-on http-get://127.0.0.1:4200 && npm run build:electron && set \"ELECTRON_RUN_AS_NODE=\" && electron . --dev-server-url=http://127.0.0.1:4200",
    "build": "npm run build:angular && npm run build:electron",
    "build:angular": "ng build",
    "build:electron": "tsc --project tsconfig.electron.json && esbuild electron/preload.ts --bundle --platform=node --format=cjs --external:electron --outfile=dist-electron/preload.js",
    "build:ocr": ".venv-ocr\\Scripts\\python.exe ocr\\build_ocr.py",
    "package:win": "npm run build:ocr && npm run build && electron-builder --win --x64",
    "watch": "ng build --watch --configuration development",
    "test": "ng test"
  },
  "private": true,
  "packageManager": "npm@11.16.0",
  "dependencies": {
    "@angular/common": "^22.1.0",
    "@angular/compiler": "^22.1.0",
    "@angular/core": "^22.1.0",
    "@angular/forms": "^22.1.0",
    "@angular/platform-browser": "^22.1.0",
    "@angular/router": "^22.1.0",
    "docxtemplater": "^3.70.0",
    "pizzip": "^3.2.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.1.7",
    "@angular/cli": "^22.1.7",
    "@angular/compiler-cli": "^22.1.0",
    "@types/node": "^24.0.0",
    "concurrently": "^10.0.5",
    "electron": "^44.3.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "jsdom": "^28.0.0",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2",
    "vitest": "^4.0.8",
    "wait-on": "^9.1.0"
  },
  "build": {
    "appId": "com.documentfiller.app",
    "productName": "Document Filler",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": ".ocr-build/ocr",
        "to": "ocr",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
